II WAY -> socket
#!/usr/bin/env python3
import socket
import struct
dst = bytes.fromhex("ff ff ff ff ff ff")
src = bytes.fromhex("aa aa aa aa aa aa")
ethertype = 0xFFFF
header = struct.pack(
        "!6s6sH",
        dst,
        src,
        ethertype
)
payload = b"ciao"
frame = header + payload
INTERFACE = "eth0"
if len(frame) < 60:
    frame += b"\x00" * (60 - len(frame))
s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW)
s.bind((INTERFACE, 0))
s.send(frame)

