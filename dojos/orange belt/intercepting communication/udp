#!/usr/bin/env python3

import socket

sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.bind(("10.0.0.1", 12345))

sock.sendto(b"Hello, World!\n", ("10.0.0.2", 31337))

data, addr = sock.recvfrom(4096)
print(addr, data)


