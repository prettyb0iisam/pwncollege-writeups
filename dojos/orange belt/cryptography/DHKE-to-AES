#!/usr/bin/env python3
from pwn import *
from Crypto.Cipher import AES
context.log_level = 'error'
p = process("/challenge/run")
B = p.recvline().strip().decode()[4:]
p.sendline(B.encode())
p.recvuntil("Flag Ciphertext (hex): ".encode())
flag = p.recvline().strip().decode()
key = "00000000000000000000000000000000"
cipher = AES.new(bytes.fromhex(key), AES.MODE_CBC)
flag_enc = cipher.decrypt(bytes.fromhex(flag))[16:75]
print(flag_enc.decode())

