#!/usr/bin/env python3
from pwn import *
import math
context.log_level = "error"
p = process("/challenge/run")
p.recvuntil(b"e = 0x")
e_int = int(p.recvline().strip(), 16)
p.recvuntil(b"p = 0x")
p_int = int(p.recvline().strip(), 16)
p.recvuntil(b"q = 0x")
q_int = int(p.recvline().strip(), 16)
p.recvuntil(b"Flag Ciphertext (hex): ")
flag_enc_hex = p.recvline().strip().decode()
c = int.from_bytes(bytes.fromhex(flag_enc_hex), "little")
n_int = p_int * q_int
phi_int = (p_int-1)*(q_int-1)
d_int = pow(e_int, -1, phi_int)
m = pow(c, d_int, n_int)
flag = m.to_bytes(256, "little").rstrip(b"\x00")
print(flag.decode())

