#!/usr/bin/env python3
from pwn import *
from Crypto.Util import number
import base64
context.log_level = "error"
p = process("/challenge/run")
e = 3
while True:
    n = number.getPrime(1023)
    if (n - 1) % e != 0:
        break
d = pow(e, -1, n - 1)
p.sendline(f"0x{e:x}".encode())
p.sendline(f"0x{n:x}".encode())
p.recvuntil(b"challenge: 0x")
c = int(p.recvline().strip(), 16)
response = pow(c, d, n)
p.sendline(f"0x{response:x}".encode())
p.recvuntil(b"secret ciphertext (b64): ")
ct_b64 = p.recvline().strip().decode()
ct_bytes = base64.b64decode(ct_b64)
ct_int = int.from_bytes(ct_bytes, "little")
flag_int = pow(ct_int, d, n)
flag_bytes = flag_int.to_bytes(64, "little").rstrip(b"\x00")
print(flag_bytes.decode())

