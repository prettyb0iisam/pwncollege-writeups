.intel_syntax noprefix
.global _start
_start:
xor     rdi,rdi
mov     rsi, [rsp+16]
loop:
cmp     BYTE PTR [rsi], 0
je      exit
inc     rdi
inc     rsi
jmp     loop
exit:
mov     rax, 60
syscall

