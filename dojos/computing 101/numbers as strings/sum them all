itoa:
        push    rsi
        xor     rax, rax
        push    r11
        xor     r11,r11
        cmp     rdi, 0
        jg      poss
        je      zero_case
        neg     rdi
        add     r11, 1
        mov     BYTE PTR [rsi], '-'
        add     rsi, 1
poss:
        mov     rcx, 10
        mov     rax, rdi
        push    r12
        push    rbx
        xor     rbx, rbx
div_loop:
        xor     rdx, rdx
        div     rcx
        push    rdx
        add     rbx, 1
        cmp     rax, 0
        jne     div_loop
        add     r11, rbx
write:
        pop     r12
        add     r12, 0x30
        mov     BYTE PTR [rsi], r12b
        add     rsi, 1
        sub     rbx, 1
        cmp     rbx, 0
        jne     write
        mov     rax, r11
        pop     rbx
        pop     r12
        pop     r11
        jmp     exit
zero_case:
        mov     BYTE PTR [rsi], 0x30
        mov     rax, 1
        pop     r11
        jmp     exit
exit:
        pop     rsi
        ret


atoi_digit:
        xor     rsi, rsi
        mov     sil, BYTE PTR [rdi]
        sub     rsi, 0x30
        mov     rax, rsi
        ret
atoi:
        xor     r8, r8
        xor     r9, r9
        xor     rax, rax
check_neg:
        cmp     BYTE PTR [rdi], 0x2d
        jne     loop
        mov     r9, 1
        add     rdi, 1
loop:
        cmp     BYTE PTR [rdi], 0x30
        jb      done
        cmp     BYTE PTR [rdi], 0x39
        ja      done
        mov     r11, rdi
        call    atoi_digit
        imul    r8, 10
        add     r8, rax
        add     r11, 1
        mov     rdi, r11
        jmp     loop
done:
        mov     rax, r8
        cmp     r9, 1
        jne     pos
        neg     rax
pos:
        ret



_start:
        xor     r15, r15
