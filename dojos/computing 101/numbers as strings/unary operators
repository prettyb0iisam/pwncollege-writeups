.intel_syntax noprefix
.global atoi_digit
.global atoi
.global _start
.global itoa

itoa:
        push    rsi
        xor     rax, rax
        push    r11
        xor     r11,r11
        cmp     rdi, 0
        jg      poss
        je      zero_case
        neg     rdi
        add     r11, 1
        mov     BYTE PTR [rsi], '-'
        add     rsi, 1
poss:
        mov     rcx, 10
        mov     rax, rdi
        push    r12
        push    rbx
        xor     rbx, rbx
div_loop:
        xor     rdx, rdx
        div     rcx
        push    rdx
        add     rbx, 1
        cmp     rax, 0
        jne     div_loop
        add     r11, rbx
write:
        pop     r12
        add     r12, 0x30
        mov     BYTE PTR [rsi], r12b
        add     rsi, 1
        sub     rbx, 1
        cmp     rbx, 0
        jne     write
        mov     rax, r11
        pop     rbx
        pop     r12
        pop     r11
        jmp     exit
zero_case:
        mov     BYTE PTR [rsi], 0x30
        mov     rax, 1
        pop     r11
        jmp     exit
exit:
        pop     rsi
        ret


atoi_digit:
        xor     rsi, rsi
        mov     sil, BYTE PTR [rdi]
        sub     rsi, 0x30
        mov     rax, rsi
        ret
atoi:
        xor     r8, r8
        xor     r9, r9
        xor     rax, rax
check_neg:
        cmp     BYTE PTR [rdi], 0x2d
        jne     loop
        mov     r9, 1
        add     rdi, 1
loop:
        cmp     BYTE PTR [rdi], 0x30
        jb      done
        cmp     BYTE PTR [rdi], 0x39
        ja      done
        mov     r11, rdi
        call    atoi_digit
        imul    r8, 10
        add     r8, rax
        add     r11, 1
        mov     rdi, r11
        jmp     loop
done:
        mov     rax, r8
        cmp     r9, 1
        jne     pos
        neg     rax
pos:
        ret



_start:
        cmp     BYTE PTR [rsp], 3
        je      UNARY
        cmp     BYTE PTR [rsp], 4
        jne     err

        xor     r15, r15
        mov     r13, rsp
        add     r13, 16
        mov     rdi, QWORD PTR [r13]
        call    atoi
        mov     r15, rax

        mov     r13, rsp
        add     r13, 24
        mov     r13, QWORD PTR [r13]
        cmp     BYTE PTR [r13], '+'
        je      add
        cmp     BYTE PTR [r13], '-'
        je      sub
        cmp     BYTE PTR [r13], '*'
        je      imul
        cmp     BYTE PTR [r13], '^'
        je      xoor
        cmp     BYTE PTR [r13], '|'
        je      oor
        cmp     BYTE PTR [r13], '&'
        je      annd

err:
        mov     rdi, -1
        mov     rax, 60
        syscall

UNARY:
        xor     r15, r15
        mov     r13, rsp
        add     r13, 16
        mov     r13, QWORD PTR [r13]
        cmp     BYTE PTR [r13], '-'
        je      nega
        cmp     BYTE PTR [r13], '~'
        je      tilde
        jmp     err

nega:
        mov     r13, rsp
        add     r13, 24
        mov     rdi, QWORD PTR [r13]
        call    atoi
        cmp     rax, 0
        je      zero
        mov     rdi, rax
        mov     rsi, rsp
        sub     rsi, 1000
        mov     BYTE PTR [rsi], '-'
        add     rsi, 1
        call    itoa
        mov     rdx, rax
        add     rdx, 1
        sub     rsi, 1
        mov     rax, 1
        mov     rdi, 1
        syscall
        mov     rax, 60
        mov     rdi, 0
        syscall

tilde:
        mov     r13, rsp
        add     r13, 24
        mov     rdi, QWORD PTR [r13]
        call    atoi
        neg     rax
        sub     rax, 1
        
        mov     rdi, rax
        mov     rsi, rsp
        sub     rsi, 1000
        call    itoa
        mov     rdx, rax
        mov     rax, 1
        mov     rdi, 1
        syscall
        mov     rax, 60
        mov     rdi, 0
        syscall


zero:
        mov     rsi, rsp
        sub     rsi, 1000
        mov     BYTE PTR [rsi], '0'
        mov     rdx, 1 
        mov     rax, 1
        mov     rdi, 1
        syscall
        mov     rax, 60
        mov     rdi, 0
        syscall



add:
        mov     r13, rsp
        add     r13, 32
        mov     rdi, QWORD PTR [r13]
        call    atoi
        add     r15, rax
        jmp     quit

xoor:
        mov     r13, rsp
        add     r13, 32
        mov     rdi, QWORD PTR [r13]
        call    atoi
        xor     r15, rax
        jmp     quit

sub:
        mov     r13, rsp
        add     r13, 32
        mov     rdi, QWORD PTR [r13]
        call    atoi
        sub     r15, rax
        jmp     quit

imul:
        mov     r13, rsp
        add     r13, 32
        mov     rdi, QWORD PTR [r13]
        call    atoi
        imul    r15, rax
        jmp     quit

oor:
        mov     r13, rsp
        add     r13, 32
        mov     rdi, QWORD PTR [r13]
        call    atoi
        or      r15, rax
        jmp     quit

annd:
        mov     r13, rsp
        add     r13, 32
        mov     rdi, QWORD PTR [r13]
        call    atoi
        and     r15, rax


quit:
        mov     rdi, r15
        mov     rsi, rsp
        sub     rsi, 1000

        call    itoa
        mov     rdx, rax
        mov     rax, 1
        mov     rdi, 1

        syscall
        mov     rax, 60
        mov     rdi, 0
        syscall

