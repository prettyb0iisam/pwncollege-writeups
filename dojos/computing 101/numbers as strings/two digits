.intel_syntax noprefix
.global atoi_digit
.global atoi
atoi_digit:
xor     rsi, rsi
mov     sil, BYTE PTR [rdi]
sub     rsi, 0x30
mov     rax, rsi
ret
atoi:
mov     r11, rdi
call    atoi_digit
mov     rdx, rax
add     r11, 1
mov     rdi, r11
call    atoi_digit
imul    rdx, 10
add     rax, rdx
ret

