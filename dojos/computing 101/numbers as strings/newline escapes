.intel_syntax noprefix
.global _start

_start:
        mov     rcx, rsp
        add     rcx, 16
        xor     rdx, rdx
        mov     rsi, rsp
        sub     rsi, 1000
        xor     r11, r11
        xor     r10, r10
        mov     rcx, [rcx]
        mov     r10, rsi


loop:
        cmp     BYTE PTR [rcx], 0
        je      write
        cmp     BYTE PTR [rcx], 0x5c
        jne     char
        cmp     BYTE PTR [rcx+1], 0x6e
        je      new_line

char:
        mov     r11b, BYTE PTR [rcx]
        mov     BYTE PTR [rsi], r11b
        inc     rdx
        inc     rcx
        inc     rsi
        jmp     loop

new_line:
        mov     BYTE PTR [rsi], 0x0a
        inc     rsi
        add     rcx, 2
        inc     rdx
        jmp     loop



write:
        mov     rsi, r10
        mov     rdi, 1
        mov     rax, 1
        syscall

exit:
        mov     rax, 60
        mov     rdi, 0
        syscall

